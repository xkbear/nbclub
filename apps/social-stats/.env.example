# Copy values to /etc/newbee-social-stats.env on the server. Do not commit real values.
DASHBOARD_SECRET_KEY=replace-with-a-long-random-value
DASHBOARD_ALLOWED_HOSTS=stats.new-bee.club
DASHBOARD_CSRF_ORIGINS=https://stats.new-bee.club
DASHBOARD_HTTPS=1
DASHBOARD_DB_PATH=/var/lib/newbee-social-stats/db.sqlite3
DASHBOARD_STATIC_ROOT=/opt/newbee-social-stats/apps/social-stats/staticfiles
WECHAT_APP_ID=wx8245fdb4104c1756
WECHAT_APP_SECRET=replace-on-server-only
# Set after creating a private Always Free Object Storage bucket and instance policy.
# OCI_BACKUP_BUCKET=newbee-social-stats-backups
