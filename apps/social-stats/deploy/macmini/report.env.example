# Copy to ~/Library/Application Support/NewBeeSocialStats/report.env; chmod 600.
# Mac Mini reuses the existing NewBee digest sender from its Keychain.
# Never commit or send real passwords or AppSecret in chat.
DASHBOARD_SECRET_KEY=replace-with-long-random-value
DASHBOARD_DB_PATH="$HOME/Library/Application Support/NewBeeSocialStats/db.sqlite3"
DASHBOARD_BACKUP_DIR="$HOME/Library/Application Support/NewBeeSocialStats/backups"
WECHAT_APP_ID=wx8245fdb4104c1756
WECHAT_APP_SECRET=replace-locally-only
WECHAT_ALLOWED_EGRESS_IPV4=replace-with-current-approved-ipv4
REPORT_RECIPIENTS=recipient1@example.com,recipient2@example.com
# Only set REPORT_FROM_EMAIL / REPORT_SMTP_* if using a different mail account.
